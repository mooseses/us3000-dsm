package="us3000-companion"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="US3000 Companion"
description="Live status, outage history and battery-wear tracking for the UGREEN US3000 UPS, read from DSM's own UPS service. Read-only: it never sends commands to the UPS. Enable UPS support in DSM first; the us3000 RR addon is required for the US3000 to work in DSM."
arch="noarch"
maintainer="mooseses"
maintainer_url="https://github.com/mooseses/us3000-dsm"
dsmuidir="app"
dsmappname="US3000.Companion.Application"
startable="yes"
ctl_stop="yes"
thirdparty="yes"
support_conf_folder="no"
silent_upgrade="yes"
checksum="@CHECKSUM@"
