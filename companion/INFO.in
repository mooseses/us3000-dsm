package="us3000-companion"
version="@VERSION@"
os_min_ver="7.0-40000"
displayname="US3000 Companion"
description="Live status, outage history, battery-wear tracking and controls (beeper, battery self-test) for the UGREEN US3000 UPS, read from DSM's own UPS service. Controls go through the us3000 addon's root gatekeeper (addon v1.2.0+), which only allows those commands. Enable UPS support in DSM first; the us3000 RR addon is required for the US3000 to work in DSM."
arch="noarch"
maintainer="mooseses"
maintainer_url="https://github.com/mooseses/us3000-dsm"
dsmuidir="app"
dsmappname="US3000.Companion.Application"
startable="yes"
ctl_stop="yes"
thirdparty="yes"
support_conf_folder="no"
silent_upgrade="yes"
checksum="@CHECKSUM@"
